{
  "name": "@maestro/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./generated/schema.d.ts",
  "files": [
    "generated/schema.d.ts",
    "openapi.yaml"
  ],
  "scripts": {
    "audit": "node scripts/audit-contract.mjs",
    "lint": "redocly lint maestro@v1 --config redocly.yaml",
    "generate": "openapi-typescript --redocly redocly.yaml --immutable --alphabetize --default-non-nullable false",
    "generate:check": "openapi-typescript --redocly redocly.yaml --immutable --alphabetize --default-non-nullable false --check",
    "test": "pnpm run generate:check && pnpm run audit",
    "typecheck": "tsc --project tsconfig.json",
    "check": "pnpm run lint && pnpm run generate:check && pnpm run audit && pnpm run typecheck"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.1"
    }
  },
  "packageManager": "pnpm@10.10.0"
}
