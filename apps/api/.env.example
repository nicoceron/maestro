APP_NAME=Maestro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
INVITATION_EXPIRES_DAYS=7
INVITATION_RESEND_COOLDOWN_SECONDS=60
# Required in production. Generate an independent 32+ byte secret; never reuse APP_KEY.
INVITATION_TOKEN_SECRET=
PASSWORD_BREACH_TIMEOUT_SECONDS=2
AUTH_PASSWORD_TIMEOUT=600
PASSKEYS_RELYING_PARTY_ID=localhost
PASSKEYS_ALLOWED_ORIGINS=http://localhost:3000
# Required in production. Generate an independent 32+ byte secret; never reuse APP_KEY.
PASSKEYS_USER_HANDLE_SECRET=
PASSKEYS_TIMEOUT_MILLISECONDS=60000
TWO_FACTOR_CHALLENGE_SECONDS=300
TWO_FACTOR_SETUP_SECONDS=600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maestro
DB_USERNAME=maestro
DB_PASSWORD=maestro
# Used by the PostgreSQL RLS integration test. Production web/worker
# processes should use an equivalent restricted role for DB_USERNAME.
DB_RUNTIME_USERNAME=maestro_runtime
DB_RUNTIME_PASSWORD=maestro_runtime

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ABSOLUTE_LIFETIME_MINUTES=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@maestro.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
